<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Account -->
        <LinearLayout
            android:id="@+id/accountCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_round"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <ImageView
                android:id="@+id/myAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="your profile photo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/myName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading…"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Switch or log out"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/text_secondary"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_round"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/GhostRow"
                android:text="👻  Anonymous viewing: always on\nStories opened in GhostView never mark you as a viewer." />

            <TextView
                android:id="@+id/rowBrowse"
                style="@style/GhostRow"
                android:text="🌐  Browse Instagram\nOpen posts and reels to download them, also anonymous." />

            <TextView
                android:id="@+id/rowTest"
                style="@style/GhostRow"
                android:text="🧪  Connection test\nChecks login, stories, search and profiles in one go." />

            <TextView
                style="@style/GhostRow"
                android:text="📁  Downloads\nPictures / GhostView" />

            <TextView
                style="@style/GhostRow"
                android:text="🎨  Appearance\nFollows your phone (light / dark)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_round"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowLogout"
                style="@style/GhostRow"
                android:text="Log out"
                android:textColor="@color/ghost_pink"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="GhostView 2.0 · personal use only"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
